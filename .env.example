# =============================================================================
# DineFlow — Environment Variables
# Copy this file to .env and adjust values for local development.
# Never commit real secrets.
# =============================================================================

# PostgreSQL
POSTGRES_USER=dineflow
POSTGRES_PASSWORD=dineflow_dev_password
POSTGRES_DB=dineflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (used by FastAPI / Alembic)
# Docker Compose: host is "postgres"
# Local (outside Docker): use localhost
DATABASE_URL=postgresql+psycopg://dineflow:dineflow_dev_password@postgres:5432/dineflow

# JWT (placeholders — replace before any non-local use)
JWT_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
# Browser-facing API URL (what the user's browser calls)
NUXT_PUBLIC_API_URL=http://localhost:8000
NUXT_PUBLIC_DEFAULT_RESTAURANT_SLUG=bella-vista-kitchen
# Server-side API URL for Nuxt SSR (Docker Compose uses the backend service name)
NUXT_API_URL=http://backend:8000
API_URL=http://localhost:8000
FRONTEND_PORT=3000

# =============================================================================
# Production (docker-compose.prod.yml)
# =============================================================================
# ENVIRONMENT=production
# RUN_SEED=true              # set true on first deploy to load demo data, then false
# UVICORN_WORKERS=2
# Use strong secrets and your public URLs:
# CORS_ORIGINS=https://your-frontend.example.com
# NUXT_PUBLIC_API_URL=https://your-api.example.com
