# =============================================================================
# DineFlow — Environment Variables
# Copy this file to .env and adjust values for local development.
# Never commit real secrets.
# =============================================================================

# PostgreSQL
POSTGRES_USER=dineflow
POSTGRES_PASSWORD=dineflow_dev_password
POSTGRES_DB=dineflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (used by FastAPI / Alembic)
# Docker Compose: host is "postgres"
# Local (outside Docker): use localhost
DATABASE_URL=postgresql+psycopg://dineflow:dineflow_dev_password@postgres:5432/dineflow

# Row-level security: the running app connects as the restricted role "dineflow_app" (created on start-up), so PostgreSQL
# itself keeps each restaurant's rows apart. Choose a strong password in production; leave unset to run without it.
APP_DB_PASSWORD=dineflow_app_dev_password

# JWT (placeholders — replace before any non-local use)
JWT_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
# Abuse protection: per-IP/per-account rate limits on login, sign-up, orders and bookings.
RATE_LIMIT_ENABLED=true
# Only set true behind a reverse proxy you control (then the client IP is read from X-Forwarded-For).
TRUST_PROXY_HEADERS=false
# Logs: "text" for local development, "json" for production log shippers.
LOG_FORMAT=text
# File storage: "local" (backend/uploads, fine for one server) or "s3" (AWS S3, Cloudflare R2, MinIO, Spaces).
STORAGE_BACKEND=local
# For s3: the public base URL the files are served from (bucket/CDN), plus the bucket and credentials.
STORAGE_PUBLIC_URL=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Background jobs run inside the API by default. For a dedicated worker set RUN_JOB_WORKER=false
# and start `python -m app.worker` as its own process.
RUN_JOB_WORKER=true

# Email: "console" (logs only, development), "smtp" (SES, Postmark, Mailgun, Gmail…) or "memory" (tests).
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=noreply@dineflow.local
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURITY=starttls
# Where links inside emails point, and where uploaded logos are served from.
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Error reporting (optional): create a project at sentry.io and paste its DSN.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Multi-tenancy: a restaurant's site is <slug>.PLATFORM_DOMAIN (or its own custom domain).
# Dev: PLATFORM_DOMAIN=localhost makes bella-vista-kitchen.localhost:3000 work in any modern browser, and
# DEFAULT_TENANT_SLUG makes plain localhost:3000 open the demo restaurant. In production set your real
# domain (e.g. dineflow.app) and leave DEFAULT_TENANT_SLUG empty unless you want a fallback restaurant.
PLATFORM_DOMAIN=localhost
DEFAULT_TENANT_SLUG=bella-vista-kitchen

# CORS (comma-separated origins; subdomains of PLATFORM_DOMAIN are always allowed)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
# Browser-facing API URL (what the user's browser calls)
NUXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API URL for Nuxt SSR (Docker Compose uses the backend service name)
NUXT_API_URL=http://backend:8000
API_URL=http://localhost:8000
FRONTEND_PORT=3000

# =============================================================================
# Production (docker-compose.prod.yml)
# =============================================================================
# ENVIRONMENT=production
# RUN_SEED=true              # set true on first deploy to load demo data, then false
# UVICORN_WORKERS=2
# Use strong secrets and your public URLs:
# CORS_ORIGINS=https://your-frontend.example.com
# NUXT_PUBLIC_API_URL=https://your-api.example.com
