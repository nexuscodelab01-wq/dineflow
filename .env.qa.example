# =============================================================================
# DineFlow QA / staging — copy to .env.qa on the QA server.
# EVERY secret here must be different from production's. QA must never be able to touch a real restaurant's data,
# real customers' email, or a live payment.
# =============================================================================
POSTGRES_USER=dineflow
POSTGRES_PASSWORD=change-me-qa-db-password
POSTGRES_DB=dineflow
APP_DB_PASSWORD=change-me-qa-app-role-password

JWT_SECRET=change-me-qa-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-qa-refresh-secret-min-32-chars-long

# Hostnames: restaurants live at <slug>.qa.dineflow.io
PLATFORM_DOMAIN=qa.dineflow.io
DEFAULT_TENANT_SLUG=
CORS_ORIGINS=https://qa.dineflow.io
PUBLIC_SITE_URL=https://qa.dineflow.io
PUBLIC_API_URL=https://api.qa.dineflow.io
NUXT_PUBLIC_API_URL=https://api.qa.dineflow.io
NUXT_API_URL=http://backend:8000
TRUST_PROXY_HEADERS=true
LOG_FORMAT=json
RATE_LIMIT_ENABLED=true

# Demo restaurants and staff (see backend/app/db/seed.py). Safe in QA because the data is fake; keep it OFF in production.
RUN_SEED=true

# Email: "console" only logs. Never point QA at the real SMTP account — a test order would email a real address.
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=noreply@qa.dineflow.io

# Payments: Stripe TEST keys (sk_test_… / pk_test_…) so simulated readers and test cards work. A separate webhook endpoint
# (https://api.qa.dineflow.io/api/v1/webhooks/stripe) in Stripe's test mode gives the signing secrets.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# File uploads: local is fine for QA (they vanish with the volume); do NOT reuse production's bucket.
STORAGE_BACKEND=local

# Caddy's DNS-01 certificates (a Cloudflare token scoped to the dineflow.io zone).
CLOUDFLARE_API_TOKEN=

# Shown on the platform's front page as a "get DineFlow" link (optional).
NUXT_PUBLIC_CONTACT_EMAIL=
