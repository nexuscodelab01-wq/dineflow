# QA's reverse proxy — same shape as caddy/Caddyfile, on the qa. subdomain. DNS needed (Cloudflare): an A record each for
# qa.dineflow.io, *.qa.dineflow.io and api.qa.dineflow.io pointing at the QA server. (*.dineflow.io does not cover
# x.qa.dineflow.io — a wildcard matches one label — hence the separate qa wildcard.)

qa.dineflow.io, *.qa.dineflow.io {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# Keep search engines and strangers' crawlers out of the test site.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy frontend:3000
}

api.qa.dineflow.io {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy backend:8000
}
