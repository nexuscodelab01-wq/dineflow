# DineFlow's reverse proxy: the only public entry point into the stack. Backend and frontend no longer
# publish their ports directly (see docker-compose.prod.yml) — everything comes through here first.
#
# The wildcard (*.dineflow.io, one subdomain per restaurant) needs a DNS-01 ACME challenge, which needs
# a Cloudflare API token scoped to this zone's DNS (CLOUDFLARE_API_TOKEN, see .env) — see caddy/Dockerfile.

dineflow.io, *.dineflow.io {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy frontend:3000
}

api.dineflow.io {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy backend:8000
}

# ---- QA (docker-compose.qa.yml runs on this same server) -------------------------------------------------------------
# A wildcard matches one label, so *.dineflow.io does not cover x.qa.dineflow.io: QA gets its own wildcard. DNS (Cloudflare,
# "DNS only"): A records for qa, *.qa and api.qa pointing at this server. If the QA containers are stopped these hostnames
# simply answer 502 — production is unaffected either way.

qa.dineflow.io, *.qa.dineflow.io {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# Keep search engines out of the test site.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy qa-frontend:3000
}

api.qa.dineflow.io {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy qa-backend:8000
}
