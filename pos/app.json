{
  "expo": {
    "name": "DineFlow POS",
    "slug": "dineflow-pos",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sukhvirsingh.dineflowpos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "locationWhenInUsePermission": "DineFlow POS needs your location to process card payments.",
          "bluetoothPeripheralPermission": "DineFlow POS uses Bluetooth to connect to the card reader.",
          "bluetoothAlwaysUsagePermission": "DineFlow POS uses Bluetooth to connect to the card reader."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9208a652-4ab0-4776-9f06-7644313ad42d"
      }
    }
  }
}
